{
  "name": "fightme",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "An original 2D fighting game where every fighter picks a fighting style: Street (6-button, Drive system) or Iron (4-limb, strings, Heat).",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "smoke": "node scripts/smoke.mjs"
  },
  "dependencies": {
    "three": "0.186.1"
  },
  "devDependencies": {
    "@types/three": "0.186.0",
    "playwright-core": "1.64.1",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
